{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh -c 'if [ -f app/package.json ]; then npm run build --prefix app; else npm run build; fi'",
  "outputDirectory": ".",
  "installCommand": "sh -c 'if [ -f app/package.json ]; then npm ci --prefix app; else npm ci; fi'",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/index.html"
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/index.html"
    },
    {
      "src": "^/socials\\.html$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/socials.html"
    },
    {
      "src": "^/schedule\\.html$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/schedule.html"
    },
    {
      "src": "^/assets/(.*)$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/assets/$1"
    },
    {
      "src": "^/shared/(.*)$",
      "has": [{ "type": "header", "key": "host", "value": "slurpsdirtysoda.vercel.app" }],
      "dest": "/demos/slurps/shared/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

